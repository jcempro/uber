/** MPL-2.0; RCF8.4; FT-003.43.1. Custo total projetado/km total; sem certificação de realização/cobertura. */
import {inspectExactLimits,type ExactLimits} from './exact-budget';
import type {ExactRational} from './exact';
import type {BudgetPeriod} from './model';
import {calculateFinancialProjection,type FinancialProjectionInput,type FinancialProjectionResult} from './financial-result';
import {calculateExactProduct,type ExactProductFailure} from './exact-product';
import {compareExactRationals,type ExactComparisonFailure} from './exact-compare';
export interface FinancialCostPerKilometerInput extends FinancialProjectionInput {readonly totalDistance:ExactRational}
export type FinancialCostPerKilometerMetric=
  | {readonly status:'ready';readonly value:ExactRational}
  | {readonly status:'unavailable';readonly code:'zero-distance';readonly reason:string;readonly calculation:null}
  | {readonly status:'unavailable';readonly code:'calculation-unavailable';readonly reason:string;readonly calculation:ExactProductFailure};
export type FinancialCostPerKilometerResult=
  | {readonly status:'conditional';readonly kind:'projection';readonly contextId:string;readonly period:BudgetPeriod;readonly financialAssessment:'not-evaluated';readonly costCoverage:'not-evaluated';readonly taxAssessment:'not-evaluated';readonly costBasis:'planned-total-cost';readonly distanceBasis:'total-distance';readonly projection:Extract<FinancialProjectionResult,{status:'ready'}>;readonly value:{readonly totalDistance:ExactRational;readonly costPerKilometer:FinancialCostPerKilometerMetric}}
  | {readonly status:'unavailable';readonly code:'invalid-budget'|'projection-unavailable'|'invalid-distance'|'calculation-unavailable';readonly reason:string;readonly projection:FinancialProjectionResult|null;readonly calculation:ExactProductFailure|ExactComparisonFailure|null};
type CostPerKilometerFailure=Extract<FinancialCostPerKilometerResult,{status:'unavailable'}>;
function costPerKilometerFailure(code:CostPerKilometerFailure['code'],reason:string,projection:FinancialProjectionResult|null=null,calculation:CostPerKilometerFailure['calculation']=null):CostPerKilometerFailure{return Object.freeze({status:'unavailable',code,reason,projection,calculation});}
type CostPerKilometerContext={readonly status:'ready';readonly limits:ExactLimits;readonly projection:Extract<FinancialProjectionResult,{status:'ready'}>;readonly totalDistance:ExactRational;readonly zeroDistance:boolean};
type CostPerKilometerContextResult=CostPerKilometerContext|CostPerKilometerFailure;

function prepareCostPerKilometer(input:FinancialCostPerKilometerInput,limits:ExactLimits):CostPerKilometerContextResult{const inspected=inspectExactLimits(limits);if(!inspected.valid)return costPerKilometerFailure('invalid-budget',inspected.reason);const projectionResult=calculateFinancialProjection(input,inspected.limits);if(projectionResult.status==='unavailable')return costPerKilometerFailure('projection-unavailable',projectionResult.reason,projectionResult,null);const normalizedDistance=calculateExactProduct('multiply',input.totalDistance,Object.freeze({numerator:'1',denominator:'1'}),inspected.limits);if(normalizedDistance.status==='unavailable')return costPerKilometerFailure(normalizedDistance.code==='invalid-rational'?'invalid-distance':'calculation-unavailable',normalizedDistance.reason,projectionResult,normalizedDistance);const comparison=compareExactRationals(normalizedDistance.value,Object.freeze({numerator:'0',denominator:'1'}),inspected.limits);if(comparison.status==='unavailable')return costPerKilometerFailure('calculation-unavailable',comparison.reason,projectionResult,comparison);if(comparison.order<0)return costPerKilometerFailure('invalid-distance','totalDistance não pode ser negativa.',projectionResult,null);const zeroDistance=comparison.order===0;return Object.freeze({status:'ready',limits:inspected.limits,projection:projectionResult,totalDistance:normalizedDistance.value,zeroDistance});}
export function calculateFinancialCostPerKilometer(input:FinancialCostPerKilometerInput,limits:ExactLimits):FinancialCostPerKilometerResult{const ctx=prepareCostPerKilometer(input,limits);if(ctx.status==='unavailable')return ctx;if(ctx.zeroDistance){const metric:FinancialCostPerKilometerMetric=Object.freeze({status:'unavailable',code:'zero-distance',reason:'total-distance é zero; métrica não calculável',calculation:null});return Object.freeze({status:'conditional',kind:'projection',contextId:ctx.projection.contextId,period:ctx.projection.period,financialAssessment:'not-evaluated',costCoverage:'not-evaluated',taxAssessment:'not-evaluated',costBasis:'planned-total-cost',distanceBasis:'total-distance',projection:ctx.projection,value:Object.freeze({totalDistance:ctx.totalDistance,costPerKilometer:metric})});}const costPerKilometer=calculateExactProduct('divide',ctx.projection.value.plannedTotalCost,ctx.totalDistance,ctx.limits);if(costPerKilometer.status==='unavailable'){const metric:FinancialCostPerKilometerMetric=Object.freeze({status:'unavailable',code:'calculation-unavailable',reason:costPerKilometer.reason,calculation:costPerKilometer});return Object.freeze({status:'conditional',kind:'projection',contextId:ctx.projection.contextId,period:ctx.projection.period,financialAssessment:'not-evaluated',costCoverage:'not-evaluated',taxAssessment:'not-evaluated',costBasis:'planned-total-cost',distanceBasis:'total-distance',projection:ctx.projection,value:Object.freeze({totalDistance:ctx.totalDistance,costPerKilometer:metric})});}const metric:FinancialCostPerKilometerMetric=Object.freeze({status:'ready',value:costPerKilometer.value});return Object.freeze({status:'conditional',kind:'projection',contextId:ctx.projection.contextId,period:ctx.projection.period,financialAssessment:'not-evaluated',costCoverage:'not-evaluated',taxAssessment:'not-evaluated',costBasis:'planned-total-cost',distanceBasis:'total-distance',projection:ctx.projection,value:Object.freeze({totalDistance:ctx.totalDistance,costPerKilometer:metric})});}
